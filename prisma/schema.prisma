datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

model User {
  // TODO(student): Add @map("_id") @db.ObjectId
  id           String      @id @default(auto())
  email        String      @unique
  name         String
  passwordHash String
  role         Role        @default(MEMBER)
  workspaces   Workspace[]
  createdAt    DateTime    @default(now())

  @@map("users")
}

model Workspace {
  // TODO(student): Add @map("_id") @db.ObjectId
  id        String   @id @default(auto())
  name      String   @unique
  ownerId   String   @db.ObjectId
  owner     User     @relation(fields: [ownerId], references: [id])
  tasks     Task[]
  createdAt DateTime @default(now())

  @@map("workspaces")
}

model Task {
  // TODO(student): Add @map("_id") @db.ObjectId, onDelete: Cascade on workspace relation, and ESR @@index
  id          String     @id @default(auto())
  title       String
  status      TaskStatus @default(TODO)
  workspaceId String     @db.ObjectId
  workspace   Workspace  @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime   @default(now())

  @@map("tasks")
}
