{
  "name": "taskhub-course-lab",
  "version": "1.0.0",
  "description": "Stage 1 Node.js Back-End Engineering — Instructor Explain & Student Test Lab Repository",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "express": "^5.3.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "prisma": "^6.19.2"
  }
}
