{
  "info": {
    "name": "TaskHub \u2014 Session 2: HTTP, REST & Envelopes",
    "description": "Hands-on Postman collection for testing TaskHub S02 contract-server.js status codes (200, 201, 204, 400, 404, 409, 422), PATCH partial updates, and pm.test() assertions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "1. List Workspaces (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Envelope success is true', () => pm.expect(pm.response.json().success).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/workspaces"
      }
    },
    {
      "name": "2. Create Workspace (201 Created)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "pm.test('Returns created workspace', () => pm.expect(pm.response.json().data.name).to.eql('Product'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Product\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/workspaces"
      }
    },
    {
      "name": "3. Create Workspace \u2014 Validation Error (422)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 422', () => pm.response.to.have.status(422));",
              "pm.test('ErrorCode is VALIDATION_ERROR', () => pm.expect(pm.response.json().errorCode).to.eql('VALIDATION_ERROR'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/workspaces"
      }
    },
    {
      "name": "4. Create Workspace \u2014 Malformed JSON (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"name\": \"Broken JSON\""
        },
        "url": "{{baseUrl}}/api/v1/workspaces"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', () => pm.response.to.have.status(400));",
              "pm.test('ErrorCode is INVALID_JSON', () => pm.expect(pm.response.json().errorCode).to.eql('INVALID_JSON'));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Create Workspace \u2014 Duplicate Name (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Engineering\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/workspaces"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 409', () => pm.response.to.have.status(409));",
              "pm.test('ErrorCode is DUPLICATE_WORKSPACE', () => pm.expect(pm.response.json().errorCode).to.eql('DUPLICATE_WORKSPACE'));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Partial Update Workspace \u2014 PATCH (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Workspace renamed', () => pm.expect(pm.response.json().data.name).to.eql('Product Design'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Product Design\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/workspaces/ws-2"
      }
    },
    {
      "name": "7. Delete Workspace (204 No Content)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/v1/workspaces/ws-2"
      }
    },
    {
      "name": "8. Delete Unknown Workspace (404 Not Found)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/v1/workspaces/does-not-exist"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 404', () => pm.response.to.have.status(404));",
              "pm.test('ErrorCode is NOT_FOUND', () => pm.expect(pm.response.json().errorCode).to.eql('NOT_FOUND'));"
            ]
          }
        }
      ]
    }
  ]
}
